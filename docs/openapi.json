{
  "openapi": "3.0.3",
  "info": {
    "title": "WhatsApp Sticker API",
    "description": "Generate WhatsApp stickers using OpenRouter AI",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "url": "https://example.com/support"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Same host as this OpenAPI document (works for localhost and LAN IP)"
    }
  ],
  "paths": {
    "/api/v1/generate": {
      "post": {
        "summary": "Generate WhatsApp sticker image",
        "description": "Generate a sticker image from text prompt with optional image context",
        "tags": ["Generation"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Prompt for sticker generation",
                    "maxLength": 2000
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional reference image"
                  },
                  "grid": {
                    "type": "boolean",
                    "description": "Request grid sheet output; when true you must send layout (e.g. 4x4) or both rows and cols",
                    "default": false
                  },
                  "layout": {
                    "type": "string",
                    "description": "Grid dimensions like 4x4 (alternative to rows + cols when grid is true)",
                    "example": "4x4"
                  },
                  "rows": {
                    "type": "integer",
                    "description": "Grid row count when grid is true (use with cols)",
                    "minimum": 1
                  },
                  "cols": {
                    "type": "integer",
                    "description": "Grid column count when grid is true (use with rows)",
                    "minimum": 1
                  },
                  "normalize": {
                    "type": "boolean",
                    "description": "When grid is true, optionally normalize the sheet before splitting (same as /grid/split)",
                    "default": false
                  }
                },
                "required": ["text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully generated image(s)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/grid/split": {
      "post": {
        "summary": "Split grid image",
        "description": "Split a grid image into individual images using AI detection",
        "tags": ["Grid"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Grid image to split"
                  }
                },
                "required": ["image"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully split grid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GridSplitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Grid detection failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/background/remove": {
      "post": {
        "summary": "Remove background",
        "description": "Remove background from an image",
        "tags": ["Background"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image to remove background from"
                  }
                },
                "required": ["image"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully removed background",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackgroundRemoveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Check API health status",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImageResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          }
        }
      },
      "GenerationMetadata": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "tokensPrompt": {
            "type": "integer"
          },
          "tokensCompletion": {
            "type": "integer"
          },
          "cost": {
            "type": "number"
          },
          "latencyMs": {
            "type": "integer"
          },
          "gridLayout": {
            "type": "string"
          },
          "cellCount": {
            "type": "integer"
          },
          "normalizedImageUrl": {
            "type": "string"
          },
          "outputSize": {
            "type": "string"
          },
          "normalized": {
            "type": "boolean"
          },
          "backgroundRemoved": {
            "type": "boolean"
          },
          "backgroundRemovalMethod": {
            "type": "string"
          }
        }
      },
      "GenerateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ImageResult"
                }
              },
              "metadata": {
                "$ref": "#/components/schemas/GenerationMetadata"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "GridSplitResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ImageResult"
                }
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "gridLayout": {
                    "type": "string"
                  },
                  "cellCount": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "BackgroundRemoveResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "image": {
                "$ref": "#/components/schemas/ImageResult"
              },
              "metadata": {
                "type": "object"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
