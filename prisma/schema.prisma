generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([name])
  @@index([resource, action])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  username      String    @unique
  displayName   String?
  roleId        String
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role           Role            @relation(fields: [roleId], references: [id])
  authIdentities AuthIdentity[]
  stickers       Sticker[]
  sharedStickers StickerShare[]  @relation("SharedWith")
  grantedShares  StickerShare[]  @relation("GrantedBy")
  shareLinks     StickerShareLink[]
  refreshTokens  RefreshToken[]
  
  // Sticker Pack relations
  stickerPacks       StickerPack[]
  sharedStickerPacks StickerPackShare[]  @relation("PackSharedWith")
  grantedPackShares  StickerPackShare[]  @relation("PackGrantedBy")
  packShareLinks     StickerPackShareLink[] @relation("PackLinkCreator")
  likedStickerPacks  StickerPackLike[]
  savedStickerPacks  StickerPackSave[]
  downloadedStickerPacks StickerPackDownload[]
  followers          UserFollow[] @relation("UserFollowers")
  following          UserFollow[] @relation("UserFollowing")
  processingHistory  ProcessingHistory[]
  followerCount      Int @default(0)
  followingCount     Int @default(0)
  subscriptionTier   String @default("free")
  notifications      UserNotification[]
  purchases          Purchase[]
  creditBalance      UserCreditBalance?
  tokenLedgerEntries TokenLedgerEntry[]
  subscriptions      UserSubscription[]
  blockedUsers       UserBlock[] @relation("UserBlocks")
  blockedByUsers     UserBlock[] @relation("UserBlockedBy")
  contentReports     ContentReport[] @relation("ContentReporter")
  accountDeletionRequests AccountDeletionRequest[]

  @@index([email])
  @@index([username])
  @@index([roleId])
}

model AuthIdentity {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum StickerVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model Sticker {
  id         String            @id @default(uuid())
  ownerId    String
  name       String
  filename   String
  url        String
  visibility StickerVisibility @default(PRIVATE)
  width      Int?
  height     Int?
  fileSize   Int?
  mimeType   String?
  metadata   Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  owner   User             @relation(fields: [ownerId], references: [id])
  shares  StickerShare[]
  shareLinks StickerShareLink[]
  
  // Sticker Pack relation
  stickerPacks StickerPackSticker[]

  @@index([ownerId])
  @@index([visibility])
  @@index([createdAt])
  @@index([deletedAt])
}

enum SharePermission {
  VIEW
  EDIT
}

model StickerShare {
  id           String          @id @default(uuid())
  stickerId    String
  sharedWithId String
  permission   SharePermission @default(VIEW)
  grantedBy    String
  createdAt    DateTime        @default(now())
  expiresAt    DateTime?

  sticker    Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  sharedWith User    @relation("SharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)
  granter    User    @relation("GrantedBy", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@unique([stickerId, sharedWithId])
  @@index([stickerId])
  @@index([sharedWithId])
  @@index([grantedBy])
  @@index([expiresAt])
}

model StickerShareLink {
  id        String          @id @default(uuid())
  stickerId String
  token     String          @unique
  permission SharePermission @default(VIEW)
  createdBy String
  expiresAt DateTime?
  maxUses   Int?
  usesCount Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([stickerId])
  @@index([token])
  @@index([createdBy])
  @@index([expiresAt])
  @@index([isActive])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Sticker Pack Models
model StickerPack {
  id          String              @id @default(uuid())
  ownerId     String
  name        String
  description String?
  visibility  StickerVisibility   @default(PRIVATE)
  likeCount   Int                  @default(0)
  saveCount   Int                  @default(0)
  downloadCount Int                @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  owner       User                 @relation(fields: [ownerId], references: [id])
  stickers    StickerPackSticker[]
  shares      StickerPackShare[]
  shareLinks  StickerPackShareLink[]
  likes       StickerPackLike[]
  saves       StickerPackSave[]
  downloads   StickerPackDownload[]
  featured    FeaturedStickerPack?

  @@index([ownerId])
  @@index([visibility])
  @@index([deletedAt])
  @@index([updatedAt])
}

model FeaturedStickerPack {
  id            String   @id @default(uuid())
  stickerPackId String   @unique
  score         Float
  windowStart   DateTime
  windowEnd     DateTime
  createdAt     DateTime @default(now())

  stickerPack StickerPack @relation(fields: [stickerPackId], references: [id], onDelete: Cascade)

  @@index([windowEnd])
  @@index([score])
}

model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Curated AI prompt templates for generate flows (managed server-side).
model PromptPreset {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  category      String
  prompt        String
  referenceHint String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isActive, sortOrder])
}

model StickerPackSticker {
  id            String    @id @default(uuid())
  stickerPackId String
  stickerId     String
  order         Int       @default(0)
  createdAt     DateTime  @default(now())

  stickerPack   StickerPack @relation(fields: [stickerPackId], references: [id], onDelete: Cascade)
  sticker       Sticker     @relation(fields: [stickerId], references: [id], onDelete: Cascade)

  @@unique([stickerPackId, stickerId])
  @@index([stickerPackId])
  @@index([stickerId])
}

model StickerPackShare {
  id            String          @id @default(uuid())
  stickerPackId String
  sharedWithId  String
  permission    SharePermission @default(VIEW)
  grantedBy     String
  createdAt     DateTime        @default(now())
  expiresAt     DateTime?

  stickerPack   StickerPack @relation(fields: [stickerPackId], references: [id], onDelete: Cascade)
  sharedWith    User        @relation("PackSharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)
  granter       User        @relation("PackGrantedBy", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@unique([stickerPackId, sharedWithId])
  @@index([stickerPackId])
  @@index([sharedWithId])
  @@index([grantedBy])
  @@index([expiresAt])
}

model StickerPackShareLink {
  id            String          @id @default(uuid())
  stickerPackId String
  token         String          @unique
  permission    SharePermission @default(VIEW)
  createdBy     String
  expiresAt     DateTime?
  maxUses       Int?
  usesCount     Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  stickerPack   StickerPack @relation(fields: [stickerPackId], references: [id], onDelete: Cascade)
  creator       User        @relation("PackLinkCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([stickerPackId])
  @@index([token])
  @@index([createdBy])
  @@index([expiresAt])
  @@index([isActive])
}

model StickerPackLike {
  id            String   @id @default(uuid())
  stickerPackId String
  userId        String
  createdAt     DateTime @default(now())

  stickerPack StickerPack @relation(fields: [stickerPackId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stickerPackId, userId])
  @@index([stickerPackId])
  @@index([userId])
  @@index([createdAt])
}

model StickerPackSave {
  id            String   @id @default(uuid())
  stickerPackId String
  userId        String
  createdAt     DateTime @default(now())

  stickerPack StickerPack @relation(fields: [stickerPackId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stickerPackId, userId])
  @@index([stickerPackId])
  @@index([userId])
  @@index([createdAt])
}

model StickerPackDownload {
  id            String   @id @default(uuid())
  stickerPackId String
  userId        String
  createdAt     DateTime @default(now())

  stickerPack StickerPack @relation(fields: [stickerPackId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stickerPackId])
  @@index([userId])
  @@index([createdAt])
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
}

// Processing History for generate/grid-split/background-remove
model ProcessingHistory {
  id          String   @id @default(uuid())
  userId      String
  type        String   // 'generate' | 'grid-split' | 'background-remove'
  inputData   Json?    // prompt, rows/cols, etc
  outputFiles Json     // array of {url, path, filename, width, height}
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@index([createdAt])
}

enum BillingProvider {
  GOOGLE_PLAY
  APPLE_APP_STORE
  XENDIT
  ADMIN
  PROMO
}

enum PurchaseType {
  CONSUMABLE_TOKEN_PACK
  SUBSCRIPTION
  NON_CONSUMABLE
}

enum PurchaseStatus {
  PENDING
  VERIFIED
  FULFILLED
  FAILED
  REFUNDED
  REVOKED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  ON_HOLD
  PAUSED
  PAST_DUE
  CANCELLED
  EXPIRED
  REVOKED
}

model BillingProduct {
  id                  String       @id @default(uuid())
  code                String       @unique
  type                PurchaseType
  name                String
  description         String?
  tokenAmount         Int?
  tierCode            String?
  dailyPointLimit     Int?
  isActive            Boolean      @default(true)
  sortOrder           Int          @default(0)
  googlePlayProductId String?
  appleProductId      String?
  xenditProductCode   String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Purchase {
  id                            String          @id @default(uuid())
  userId                        String
  provider                      BillingProvider
  type                          PurchaseType
  status                        PurchaseStatus  @default(PENDING)
  productCode                   String
  productName                   String
  tokenAmount                   Int?
  tierCode                      String?
  dailyPointLimit               Int?
  providerProductId             String?
  providerPurchaseToken         String?
  providerTransactionId         String?
  providerOriginalTransactionId String?
  providerOrderId               String?
  providerStatus                String?
  providerPayload               Json?
  verifiedAt                    DateTime?
  fulfilledAt                   DateTime?
  refundedAt                    DateTime?
  revokedAt                     DateTime?
  expiresAt                     DateTime?
  idempotencyKey                String          @unique
  metadata                      Json?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  user                          User            @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([provider, providerTransactionId])
  @@index([provider, providerPurchaseToken])
  @@index([productCode])
}

model UserCreditBalance {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model TokenLedgerEntry {
  id             String   @id @default(uuid())
  userId         String
  purchaseId     String?
  delta          Int
  balanceAfter   Int
  reason         String
  source         String
  idempotencyKey String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([purchaseId])
}

model UserSubscription {
  id                            String             @id @default(uuid())
  userId                        String
  provider                      BillingProvider
  productCode                   String
  tierCode                      String
  status                        SubscriptionStatus @default(ACTIVE)
  providerSubscriptionId        String?
  providerOriginalTransactionId String?
  providerPurchaseToken         String?
  currentPeriodStart            DateTime?
  currentPeriodEnd              DateTime?
  autoRenewing                  Boolean            @default(false)
  cancelAtPeriodEnd             Boolean            @default(false)
  lastVerifiedAt                DateTime?
  metadata                      Json?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  user                          User               @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([provider, providerSubscriptionId])
  @@index([provider, providerPurchaseToken])
}

model StoreNotificationEvent {
  id          String          @id @default(uuid())
  provider    BillingProvider
  eventId     String          @unique
  eventType   String
  purchaseId  String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([provider, eventType, createdAt])
}

enum ContentReportReason {
  ILLEGAL
  SEXUAL
  VIOLENCE
  CHILD_SAFETY
  HATE_HARASSMENT
  DECEPTIVE
  IP_INFRINGEMENT
  SPAM
  OTHER
}

enum ContentReportStatus {
  OPEN
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

enum ContentReportTarget {
  STICKER_PACK
  AI_OUTPUT
}

model ContentReport {
  id                  String              @id @default(uuid())
  targetType          ContentReportTarget
  packId              String?
  processingHistoryId String?
  aiJobId             String?
  reporterId          String
  reason              ContentReportReason
  details             String?
  status              ContentReportStatus @default(OPEN)
  createdAt           DateTime            @default(now())
  reviewedAt          DateTime?

  reporter User @relation("ContentReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, packId])
  @@unique([reporterId, targetType, processingHistoryId])
  @@index([status, createdAt])
  @@index([packId])
  @@index([processingHistoryId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum AccountDeletionRequestStatus {
  PENDING
  PROCESSED
  REJECTED
}

enum AccountDeletionRequestSource {
  WEB
  ADMIN
}

model AccountDeletionRequest {
  id          String                       @id @default(uuid())
  emailHash   String
  reason      String?
  status      AccountDeletionRequestStatus @default(PENDING)
  source      AccountDeletionRequestSource @default(WEB)
  ipHash      String?
  userId      String?
  createdAt   DateTime                     @default(now())
  processedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailHash, status])
  @@index([status, createdAt])
}

model PendingStoragePurge {
  id          String   @id @default(uuid())
  filePath    String
  scheduledAt DateTime @default(now())
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())

  @@index([scheduledAt])
  @@index([attempts])
}
