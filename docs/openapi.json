{
  "openapi": "3.0.3",
  "info": {
    "title": "WhatsApp Sticker API",
    "description": "Generate WhatsApp stickers using OpenRouter AI",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "url": "https://example.com/support"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Same host as this OpenAPI document (works for localhost and LAN IP)"
    }
  ],
  "paths": {
    "/api/v1/generate": {
      "post": {
        "summary": "Generate WhatsApp sticker image",
        "description": "Generate a sticker image from text prompt with optional image context",
        "tags": ["Generation"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Prompt for sticker generation",
                    "maxLength": 2000
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional reference image"
                  },
                  "grid": {
                    "type": "boolean",
                    "description": "Request grid sheet output; when true you must send layout (e.g. 4x4) or both rows and cols",
                    "default": false
                  },
                  "layout": {
                    "type": "string",
                    "description": "Grid dimensions like 4x4 (alternative to rows + cols when grid is true)",
                    "example": "4x4"
                  },
                  "rows": {
                    "type": "integer",
                    "description": "Grid row count when grid is true (use with cols)",
                    "minimum": 1
                  },
                  "cols": {
                    "type": "integer",
                    "description": "Grid column count when grid is true (use with rows)",
                    "minimum": 1
                  },
                  "normalize": {
                    "type": "boolean",
                    "description": "When grid is true, optionally normalize the sheet before splitting (same as /grid/split)",
                    "default": false
                  }
                },
                "required": ["text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully generated image(s)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/grid/split": {
      "post": {
        "summary": "Split grid image",
        "description": "Splits a sticker grid sheet into per-cell PNGs. Grid lines are detected with image heuristics, optionally combined with AI. When both `rows` and `cols` are sent, boundary detection is aligned to that row×column lattice. When `normalize` is true, the sheet is LLM-normalized and re-detected when possible; on failure the API falls back to splitting the original image. Each cell is optionally analyzed for caption-style text outside the sticker foreground, passed through background removal, then resized to a square 512×512 contain fit.",
        "tags": ["Grid"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Grid sheet image (PNG, JPEG, or WebP)"
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional row count. Use together with `cols` so split boundaries follow a fixed rows×cols lattice (same lattice behavior as `generate` with `grid=true`)."
                  },
                  "cols": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional column count. Must be sent with `rows` for lattice-aligned splitting."
                  },
                  "normalize": {
                    "type": "boolean",
                    "description": "When true, normalize the sheet via AI before re-detecting boundaries and splitting. In multipart forms you may also send the string \"true\". If normalization fails, splitting still proceeds on the original image.",
                    "default": false
                  }
                },
                "required": ["image"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully split grid; each item in `data.images` may include `textOutsideForeground` when caption-like text outside the subject was detected for that cell. See `data.metadata` for layout and normalization URLs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GridSplitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (e.g. missing image file)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported or disallowed image type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Grid detection failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/background/remove": {
      "post": {
        "summary": "Remove background",
        "description": "Remove background from an image",
        "tags": ["Background"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image to remove background from"
                  }
                },
                "required": ["image"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully removed background",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackgroundRemoveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Check API health status",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImageResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "textOutsideForeground": {
            "description": "Only on grid-derived cells when analysis detected caption-style text outside the sticker foreground",
            "allOf": [
              {
                "$ref": "#/components/schemas/TextOutsideForeground"
              }
            ]
          }
        }
      },
      "GenerationMetadata": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "tokensPrompt": {
            "type": "integer"
          },
          "tokensCompletion": {
            "type": "integer"
          },
          "cost": {
            "type": "number"
          },
          "latencyMs": {
            "type": "integer"
          },
          "gridLayout": {
            "type": "string"
          },
          "cellCount": {
            "type": "integer"
          },
          "normalizedImageUrl": {
            "type": "string"
          },
          "outputSize": {
            "type": "string"
          },
          "normalized": {
            "type": "boolean"
          },
          "backgroundRemoved": {
            "type": "boolean"
          },
          "backgroundRemovalMethod": {
            "type": "string"
          }
        }
      },
      "GenerateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ImageResult"
                }
              },
              "metadata": {
                "$ref": "#/components/schemas/GenerationMetadata"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "TextStyleMetadata": {
        "type": "object",
        "description": "Optional caption typography inferred when text sits outside the sticker foreground",
        "properties": {
          "fontFamily": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          }
        }
      },
      "TextOutsideForeground": {
        "type": "object",
        "description": "Merged caption-style text outside the sticker subject for one cell image",
        "properties": {
          "text": {
            "type": "string"
          },
          "style": {
            "$ref": "#/components/schemas/TextStyleMetadata"
          }
        }
      },
      "GridSplitMetadata": {
        "type": "object",
        "properties": {
          "gridLayout": {
            "type": "string",
            "description": "Detected grid layout label (e.g. 4x4)"
          },
          "cellCount": {
            "type": "integer",
            "description": "Number of cells produced (matches length of `data.images`)"
          },
          "normalizedImageUrl": {
            "type": "string",
            "description": "Public URL of the AI-normalized full sheet when `normalize` succeeded"
          },
          "outputSize": {
            "type": "string",
            "example": "512x512",
            "description": "Final square contain size for each cell image"
          },
          "normalized": {
            "type": "boolean",
            "description": "Whether normalization was requested and a normalized sheet URL was stored"
          },
          "backgroundRemoved": {
            "type": "boolean",
            "description": "Whether background removal succeeded for at least one cell"
          },
          "backgroundRemovalMethod": {
            "type": "string",
            "description": "Which removal pipeline(s) ran post-split, e.g. `post-split:rembg|sharp`"
          }
        }
      },
      "GridSplitResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ImageResult"
                }
              },
              "metadata": {
                "$ref": "#/components/schemas/GridSplitMetadata"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "BackgroundRemoveResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "image": {
                "$ref": "#/components/schemas/ImageResult"
              },
              "metadata": {
                "type": "object"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
